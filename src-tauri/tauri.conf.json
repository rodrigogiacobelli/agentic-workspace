{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Workspace",
  "version": "0.1.0",
  "identifier": "dev.agenticworkspace.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "workspace",
        "title": "Agentic Workspace",
        "url": "index.html#/workspace",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "visible": true
      },
      {
        "label": "terminal",
        "title": "Agentic Workspace — Terminal",
        "url": "index.html#/terminal",
        "width": 1000,
        "height": 700,
        "minWidth": 480,
        "minHeight": 300,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    },
    "enableGTKAppId": true
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"]
      }
    }
  }
}
