+                    if (old instanceof BlockWrapperTile && !owned.has(dom) && !this.cache.reused.has(old) && old.wrapper.eq(tile.wrapper)) {
+                        owned.add(dom);
+                        this.cache.reused.set(old, 2 /* Reused.DOM */);
+                        tile.setDOM(dom);
+                    }
+                    break;
+                }
+            this.adoptWrappers(tile, owned);
+        }
+    }
     preserve(length, incStart, incEnd) {
         let activeMarks = getMarks(this.old), openMarks = this.openMarks;
