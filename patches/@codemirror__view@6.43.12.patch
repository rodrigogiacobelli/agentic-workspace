+    adoptWrappers(parent, owned) {
+        if (!owned) {
+            owned = new Set;
+            let collect = (tile) => {
+                for (let ch of tile.children)
+                    if (ch instanceof BlockWrapperTile) {
+                        owned.add(ch.dom);
+                        collect(ch);
+                    }
+            };
+            collect(parent);
+        }
+        for (let tile of parent.children) {
+            if (!(tile instanceof BlockWrapperTile))
+                continue;
+            if (!tile.dom.parentNode)
+                for (let child of tile.children) {
+                    if (this.cache.reused.get(child) != 1 /* Reused.Full */)
+                        continue;
